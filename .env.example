# HTTP listening port (default: 9998)
PORT=9998

# Where the SQLite database is stored. Use an absolute path in production.
WEBSSH_DATA_DIR=./data

# Set strong values before the first start. These values only create the first
# admin in an empty data directory; they do not change an existing account.
WEBSSH_ADMIN_USERNAME=admin
WEBSSH_ADMIN_PASSWORD=pwd1234

# Set to 1 when the application is served directly over HTTPS.
# WEBSSH_SECURE_COOKIE=1
