PORT=9998
WEBSSH_DATA_DIR=./data
WEBSSH_ADMIN_USERNAME=admin
# Set a unique strong initial password, or leave unset to generate a private
# data/initial-admin-password file. Existing account passwords are unchanged.
# WEBSSH_ADMIN_PASSWORD=
# Do not configure a shared default SSH password unless explicitly required.
# WEBSSH_DEFAULT_SSH_PASSWORD=
WEBSSH_UPLOAD_MAX_MB=2048
# HTTPS reverse proxy settings (configure your actual public origin):
# WEBSSH_SECURE_COOKIE=1
# WEBSSH_ALLOWED_ORIGINS=https://ssh.example.com
# WEBSSH_TRUST_PROXY=loopback
# WEBSSH_BIND_HOST=127.0.0.1
